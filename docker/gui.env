HOST_UID = ${HOST_UID:-1000}
HOST_GID = ${HOST_GID:-1000}

WAYLAND_DISPLAY = ${WAYLAND_DISPLAY}
XDG_RUNTIME_DIR = ${XDG_RUNTIME_DIR}

# XWayland fallback configuration
DISPLAY = ${DISPLAY}

# Toolkit preferences (try Wayland first, then X11)
QT_QPA_PLATFORM = wayland;xcb
GDK_BACKEND = wayland,x11

# FIX: Forces dconf to use a writable home directory path instead of /run/user
DCONF_USER_CONFIG_DIR = .config/dconf
# FIX: Force software rendering for Mesa/OpenGL/EGL
LIBGL_ALWAYS_SOFTWARE = 1
# FIX 1: The official internal flag to completely disable the ATK bridge framework
NO_AT_BRIDGE = 1
# FIX 2: Breaks the D-Bus communication path that at-spi relies on to request plug_ids
DBUS_SESSION_BUS_ADDRESS = unix:path=/dev/null

